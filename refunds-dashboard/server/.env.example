# HTTP port for the Express API
PORT=4000

# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# SQLite file location, relative to the server folder (or absolute)
DATABASE_PATH=./data/refunds.db

# Refund requests at or above this dollar amount require a finance approver
APPROVAL_THRESHOLD_AMOUNT=200

# Number of synthetic refund requests generated on first startup (20-25)
SEED_REQUEST_COUNT=23
